# ============================================================================
# ContextEvent AI — Environment Configuration
# Copy this file to .env (local dev) and fill in real values.
# On Vercel/Railway/Render, set these as dashboard/project environment
# variables instead of committing a .env file.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (required)
# ----------------------------------------------------------------------------
# Local dev (Docker Postgres):
#   docker run --name contextevent-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=contextevent -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contextevent"
#
# Free-tier hosted Postgres options (any of these work):
#   - Railway:        Project > New > Database > PostgreSQL (free trial credit)
#   - Render:          New > PostgreSQL (free 90-day instance)
#   - Neon:            neon.tech — generous always-free serverless Postgres tier
#   - Supabase:        supabase.com — free tier Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contextevent"

# ----------------------------------------------------------------------------
# ANTHROPIC CLAUDE (required for Epic 4 — bio + conversation starter generation)
# ----------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ----------------------------------------------------------------------------
# ENRICHMENT — TIER 1 (PRIMARY)
# ----------------------------------------------------------------------------
# Default path: Apify (has a generous $5/month free platform credit, no
# enterprise sales process required — get a token at https://console.apify.com/account/integrations)
# If APIFY_API_TOKEN is unset, the app automatically runs in MOCK_MODE and
# generates deterministic realistic fake enrichment data so you can develop
# and demo the full app with zero external API keys.
APIFY_API_TOKEN=""

# Optional: override the Apify actor used for LinkedIn profile scraping
# APIFY_LINKEDIN_ACTOR_ID="dev_fusion~linkedin-profile-scraper"

# If you later upgrade to a paid identity API instead of/alongside Apify,
# these are read by optional adapters you can enable in
# src/lib/enrichment/waterfall.ts:
PDL_API_KEY=""
APOLLO_API_KEY=""

# ----------------------------------------------------------------------------
# ENRICHMENT — TIER 2 (FALLBACK / LIVE WEB SCAN)
# ----------------------------------------------------------------------------
# Hunter.io free tier gives 25 domain-search lookups/month — used to confirm
# company identity from an attendee's email domain when tier 1 is incomplete.
# Sign up free at https://hunter.io/users/sign_up
# If unset, tier 2 still runs using domain-name heuristics + Clearbit's free
# keyless logo API, just with less precision.
HUNTER_API_KEY=""

# Optional future fallback providers (implement adapters matching
# EnrichmentProvider interface in src/lib/enrichment/types.ts):
ORIGAMI_CHAT_API_KEY=""
CLEANLIST_API_KEY=""

# ----------------------------------------------------------------------------
# ENRICHMENT MODE OVERRIDE
# ----------------------------------------------------------------------------
# "true"  -> force mock enrichment data regardless of API keys present
# "false" -> force real API calls (will fail loudly if APIFY_API_TOKEN missing)
# unset   -> auto-detect: mock mode if APIFY_API_TOKEN is missing
ENRICHMENT_MOCK_MODE=""

# ----------------------------------------------------------------------------
# ADMIN PORTAL AUTHENTICATION (required)
# ----------------------------------------------------------------------------
# Password required to access /admin (upload, batch management, bio generation).
# The /event/[batchId] guest portal remains public with no login.
ADMIN_PASSWORD="choose-a-strong-password"

# Secret used to sign admin session cookies. If left unset, ADMIN_PASSWORD is
# used as the signing secret as a fallback — for production, set a separate,
# longer random value here instead (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=""

# ----------------------------------------------------------------------------
# APP URL (used for absolute links / future webhook callbacks)
# ----------------------------------------------------------------------------
# Local dev:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Local dev + ngrok tunnel (for remote access/demos):
#   1. npm run dev
#   2. ngrok http 3000
#   3. Set NEXT_PUBLIC_APP_URL to the https://*.ngrok-free.app URL ngrok gives you
#
# Vercel:   auto-detected from VERCEL_URL, but set this explicitly too
# Railway:  set to your *.up.railway.app domain
# Render:   set to your *.onrender.com domain
